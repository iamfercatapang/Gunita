{
  "name": "photobooth-kiosk",
  "version": "0.1.0",
  "private": true,
  "description": "Dual-mode event kiosk (Photo Booth + Video Guestbook) PWA",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.5.2",
    "@fontsource/inter": "^5.0.18",
    "jquery": "^3.7.1",
    "peerjs": "^1.5.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/jquery": "^3.5.30",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
